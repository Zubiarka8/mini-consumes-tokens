partial_blocks[3]{id,language,rationale}:
  pb-py-validate,python,"the payload validation block (type check, required fields, email check) repeats in create and update; the code around it differs"
  pb-py-csv,python,"the CSV reading block repeats in three importers across two files; validation before it and use after it differ"
  pb-rs-parse,rust,"the read-and-parse key=value loop repeats in two loaders; the lock check before it and the result after it differ"
