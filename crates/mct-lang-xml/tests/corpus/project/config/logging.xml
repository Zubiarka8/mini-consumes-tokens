<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback configuration. Appenders are declared by name and attached to
  loggers by <appender-ref ref="…"/>; auditLogger, sqlLogger and
  httpAccessLogger are the loggers the beans of application.xml,
  datasource.xml and security.xml write to.
-->
<!DOCTYPE configuration>
<configuration scan="true" scanPeriod="60 seconds" debug="false">

  <contextName>warehouse</contextName>

  <!-- ===================================================================
       Properties and converters
       =================================================================== -->
  <property name="LOG_DIR" value="${LOG_DIR:-/var/log/warehouse}"/>
  <property name="APP_NAME" value="warehouse"/>
  <property name="MAX_HISTORY" value="30"/>
  <property name="TOTAL_CAP" value="5GB"/>
  <property name="CONSOLE_PATTERN"
            value="%d{HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{36}) %X{tenant} - %msg%n"/>
  <property name="FILE_PATTERN"
            value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger %X{requestId} %X{tenant} - %msg%n"/>
  <property resource="logging-${ENV:-dev}.properties"/>

  <timestamp key="startup" datePattern="yyyyMMdd'T'HHmmss"/>

  <conversionRule conversionWord="redact"
                  converterClass="com.example.warehouse.logging.RedactingConverter"/>
  <conversionRule conversionWord="money"
                  converterClass="com.example.warehouse.logging.MoneyConverter"/>

  <statusListener class="ch.qos.logback.core.status.OnConsoleStatusListener"/>

  <shutdownHook class="ch.qos.logback.core.hook.DefaultShutdownHook">
    <delay>2000</delay>
  </shutdownHook>

  <!-- ===================================================================
       Appenders
       =================================================================== -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <withJansi>false</withJansi>
    <encoder>
      <pattern>${CONSOLE_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>${CONSOLE_LEVEL:-INFO}</level>
    </filter>
  </appender>

  <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/${APP_NAME}.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/archive/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>200MB</maxFileSize>
      <maxHistory>${MAX_HISTORY}</maxHistory>
      <totalSizeCap>${TOTAL_CAP}</totalSizeCap>
      <cleanHistoryOnStart>true</cleanHistoryOnStart>
    </rollingPolicy>
    <encoder>
      <pattern>${FILE_PATTERN}</pattern>
    </encoder>
  </appender>

  <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/${APP_NAME}.json</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/archive/${APP_NAME}.%d{yyyy-MM-dd}.json.gz</fileNamePattern>
      <maxHistory>14</maxHistory>
    </rollingPolicy>
    <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
      <providers>
        <timestamp>
          <timeZone>UTC</timeZone>
        </timestamp>
        <logLevel/>
        <loggerName>
          <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
        </loggerName>
        <threadName/>
        <mdc>
          <includeMdcKeyName>requestId</includeMdcKeyName>
          <includeMdcKeyName>tenant</includeMdcKeyName>
          <includeMdcKeyName>orderNumber</includeMdcKeyName>
        </mdc>
        <message/>
        <stackTrace>
          <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
            <maxDepthPerThrowable>30</maxDepthPerThrowable>
            <maxLength>4096</maxLength>
            <rootCauseFirst>true</rootCauseFirst>
            <exclude>^sun\.reflect\..*</exclude>
            <exclude>^org\.springframework\.cglib\..*</exclude>
          </throwableConverter>
        </stackTrace>
        <pattern>
          <pattern>
            {
              "app": "${APP_NAME}",
              "env": "${ENV:-dev}",
              "startup": "${startup}"
            }
          </pattern>
        </pattern>
      </providers>
    </encoder>
  </appender>

  <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/audit.log</file>
    <append>true</append>
    <immediateFlush>true</immediateFlush>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/archive/audit.%d{yyyy-MM}.log.gz</fileNamePattern>
      <maxHistory>84</maxHistory>
    </rollingPolicy>
    <encoder>
      <pattern>%d{ISO8601} %X{principal} %X{tenant} %redact(%msg)%n</pattern>
    </encoder>
  </appender>

  <appender name="SQL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/sql-slow.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
      <fileNamePattern>${LOG_DIR}/archive/sql-slow.%i.log</fileNamePattern>
      <minIndex>1</minIndex>
      <maxIndex>9</maxIndex>
    </rollingPolicy>
    <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
      <maxFileSize>50MB</maxFileSize>
    </triggeringPolicy>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %X{requestId} %msg%n</pattern>
    </encoder>
  </appender>

  <appender name="ACCESS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/access.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/archive/access.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
      <maxHistory>${MAX_HISTORY}</maxHistory>
    </rollingPolicy>
    <encoder>
      <pattern>%d{ISO8601} %X{remoteAddr} "%X{method} %X{path}" %X{status} %X{durationMs}ms%n</pattern>
    </encoder>
  </appender>

  <appender name="SYSLOG" class="ch.qos.logback.classic.net.SyslogAppender">
    <syslogHost>${SYSLOG_HOST:-localhost}</syslogHost>
    <port>514</port>
    <facility>LOCAL3</facility>
    <suffixPattern>${APP_NAME}: %logger{20} %msg</suffixPattern>
    <throwableExcluded>true</throwableExcluded>
  </appender>

  <appender name="MAIL_ALERT" class="ch.qos.logback.classic.net.SMTPAppender">
    <smtpHost>${MAIL_HOST:-smtp.example.com}</smtpHost>
    <smtpPort>587</smtpPort>
    <STARTTLS>true</STARTTLS>
    <to>oncall@example.com</to>
    <from>alerts@example.com</from>
    <subject>[${APP_NAME}] %logger{20} - %m</subject>
    <layout class="ch.qos.logback.classic.html.HTMLLayout">
      <pattern>%date%level%thread%logger%message</pattern>
    </layout>
    <cyclicBufferTracker class="ch.qos.logback.core.spi.CyclicBufferTracker">
      <bufferSize>20</bufferSize>
    </cyclicBufferTracker>
    <evaluator class="ch.qos.logback.classic.boolex.OnMarkerEvaluator">
      <marker>PAGE</marker>
    </evaluator>
  </appender>

  <!-- Wrappers: asynchronous fan-out so request threads never block on I/O. -->
  <appender name="ASYNC_APP" class="ch.qos.logback.classic.AsyncAppender">
    <queueSize>8192</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <neverBlock>true</neverBlock>
    <includeCallerData>false</includeCallerData>
    <appender-ref ref="APP_FILE"/>
  </appender>

  <appender name="ASYNC_JSON" class="ch.qos.logback.classic.AsyncAppender">
    <queueSize>8192</queueSize>
    <neverBlock>true</neverBlock>
    <appender-ref ref="JSON_FILE"/>
  </appender>

  <appender name="ASYNC_ACCESS" class="ch.qos.logback.classic.AsyncAppender">
    <queueSize>16384</queueSize>
    <neverBlock>true</neverBlock>
    <appender-ref ref="ACCESS_FILE"/>
  </appender>

  <!-- Routes each tenant to its own file, resolved from the MDC. -->
  <appender name="PER_TENANT" class="ch.qos.logback.classic.sift.SiftingAppender">
    <discriminator>
      <key>tenant</key>
      <defaultValue>shared</defaultValue>
    </discriminator>
    <sift>
      <appender name="TENANT_FILE-${tenant}" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_DIR}/tenants/${tenant}.log</file>
        <encoder>
          <pattern>${FILE_PATTERN}</pattern>
        </encoder>
      </appender>
    </sift>
  </appender>

  <!-- ===================================================================
       Turbo filters run before any logger is consulted.
       =================================================================== -->
  <turboFilter class="ch.qos.logback.classic.turbo.DuplicateMessageFilter">
    <AllowedRepetitions>5</AllowedRepetitions>
    <CacheSize>200</CacheSize>
  </turboFilter>

  <turboFilter class="ch.qos.logback.classic.turbo.MDCFilter">
    <MDCKey>tenant</MDCKey>
    <Value>load-test</Value>
    <OnMatch>DENY</OnMatch>
  </turboFilter>

  <!-- ===================================================================
       Loggers referenced by beans in the other contexts
       =================================================================== -->
  <logger name="auditLogger" level="INFO" additivity="false">
    <appender-ref ref="AUDIT_FILE"/>
    <appender-ref ref="SYSLOG"/>
  </logger>

  <logger name="sqlLogger" level="WARN" additivity="false">
    <appender-ref ref="SQL_FILE"/>
  </logger>

  <logger name="httpAccessLogger" level="INFO" additivity="false">
    <appender-ref ref="ASYNC_ACCESS"/>
  </logger>

  <!-- Domain packages -->
  <logger name="com.example.warehouse" level="${APP_LEVEL:-INFO}"/>
  <logger name="com.example.warehouse.order" level="DEBUG">
    <appender-ref ref="PER_TENANT"/>
  </logger>
  <logger name="com.example.warehouse.inventory" level="INFO"/>
  <logger name="com.example.warehouse.shipping" level="INFO"/>
  <logger name="com.example.warehouse.billing" level="INFO">
    <appender-ref ref="MAIL_ALERT"/>
  </logger>
  <logger name="com.example.warehouse.security" level="INFO">
    <appender-ref ref="AUDIT_FILE"/>
  </logger>
  <logger name="com.example.warehouse.persistence.SlowQueryMonitor" level="WARN">
    <appender-ref ref="SQL_FILE"/>
  </logger>

  <!-- Third-party libraries -->
  <logger name="org.springframework" level="WARN"/>
  <logger name="org.springframework.security" level="INFO"/>
  <logger name="org.springframework.jdbc.core.JdbcTemplate" level="${SQL_LEVEL:-WARN}"/>
  <logger name="org.springframework.transaction" level="WARN"/>
  <logger name="org.flywaydb" level="INFO"/>
  <logger name="com.zaxxer.hikari" level="WARN"/>
  <logger name="com.zaxxer.hikari.pool.HikariPool" level="INFO"/>
  <logger name="org.postgresql" level="WARN"/>
  <logger name="io.netty" level="WARN"/>
  <logger name="org.apache.http.wire" level="OFF"/>

  <!-- ===================================================================
       Root logger, varied by environment.
       =================================================================== -->
  <if condition='property("ENV").equals("prod")'>
    <then>
      <root level="INFO">
        <appender-ref ref="ASYNC_JSON"/>
        <appender-ref ref="SYSLOG"/>
        <appender-ref ref="MAIL_ALERT"/>
      </root>
    </then>
    <else>
      <root level="DEBUG">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_APP"/>
      </root>
    </else>
  </if>

  <springProfile name="test">
    <logger name="com.example.warehouse" level="WARN"/>
    <logger name="auditLogger" level="OFF"/>
    <root level="WARN">
      <appender-ref ref="CONSOLE"/>
    </root>
  </springProfile>

  <springProfile name="dev | local">
    <logger name="com.example.warehouse" level="DEBUG"/>
    <logger name="org.springframework.jdbc.core.JdbcTemplate" level="DEBUG"/>
    <logger name="org.springframework.jdbc.core.StatementCreatorUtils" level="TRACE"/>
  </springProfile>

  <!-- ===================================================================
       Metrics: every ERROR is also counted by Micrometer.
       =================================================================== -->
  <appender name="METRICS" class="io.micrometer.core.instrument.logging.LogbackMetrics$MetricsTurboFilter">
    <registryRef>metricsReporter</registryRef>
  </appender>

  <logger name="com.example.warehouse.support.PrometheusReporter" level="INFO">
    <appender-ref ref="METRICS"/>
  </logger>

  <!-- Messages with a non-ASCII payload must survive every encoder. -->
  <logger name="com.example.warehouse.i18n.Mensajería" level="INFO">
    <appender-ref ref="APP_FILE"/>
  </logger>

  <!-- ===================================================================
       Escalation chain for critical alerts. Each level waits for the
       previous one to be acknowledged before paging the next.
       =================================================================== -->
  <appender name="PAGERDUTY" class="com.example.warehouse.logging.PagerDutyAppender">
    <routingKey>${PAGERDUTY_KEY:-}</routingKey>
    <severityMapping>
      <map level="ERROR" severity="error"/>
      <map level="WARN" severity="warning"/>
    </severityMapping>
    <escalation>
      <step order="1" target="oncall-primary" waitMinutes="5"/>
      <step order="2" target="oncall-secondary" waitMinutes="10"/>
      <step order="3" target="engineering-manager" waitMinutes="20"/>
    </escalation>
    <filter class="ch.qos.logback.classic.filter.LevelFilter">
      <level>ERROR</level>
      <onMatch>ACCEPT</onMatch>
      <onMismatch>DENY</onMismatch>
    </filter>
  </appender>

  <logger name="com.example.warehouse.order.OrderService" level="INFO" additivity="true">
    <appender-ref ref="PAGERDUTY"/>
  </logger>

  <logger name="com.example.warehouse.inventory.InventoryService" level="INFO" additivity="true">
    <appender-ref ref="PAGERDUTY"/>
  </logger>

  <logger name="com.example.warehouse.shipping.ShippingService" level="INFO" additivity="true">
    <appender-ref ref="PAGERDUTY"/>
  </logger>
</configuration>
