<UserControl x:Class="Warehouse.Desktop.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:vm="clr-namespace:Warehouse.Desktop.ViewModels"
             xmlns:controls="clr-namespace:Warehouse.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="700"
             d:DataContext="{StaticResource DesignOrders}"
             Loaded="OrdersView_Loaded"
             Unloaded="OrdersView_Unloaded">
  <!--
    Orders section, shown by MainWindow's ContentHost for an
    OrdersViewModel. Opens Views/OrderEditorDialog.xaml to create or edit an
    order. The root has no name on purpose: Loaded/Unloaded above belong to
    the file itself.
  -->
  <UserControl.Resources>
    <CollectionViewSource x:Key="OrdersSource" Source="{Binding Orders}"
                          IsLiveSortingRequested="True" IsLiveFilteringRequested="True">
      <CollectionViewSource.SortDescriptions>
        <scm:SortDescription xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
                             PropertyName="CreatedAt" Direction="Descending"/>
      </CollectionViewSource.SortDescriptions>
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="Status"/>
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>

    <x:Array x:Key="StatusFilters" Type="{x:Type sys:String}">
      <sys:String>Todos</sys:String>
      <sys:String>Nuevos</sys:String>
      <sys:String>Reservados</sys:String>
      <sys:String>Enviados</sys:String>
      <sys:String>Cancelados</sys:String>
    </x:Array>

    <DataTemplate x:Key="OrderGroupHeader">
      <StackPanel Orientation="Horizontal" Margin="4,8,0,4">
        <TextBlock Text="{Binding Name, Converter={StaticResource EnumDisplay}}"
                   FontWeight="Bold"/>
        <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}"
                   Foreground="{DynamicResource MutedTextBrush}"/>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid x:Name="OrdersRoot">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="520"/>
      <ColumnDefinition Width="6"/>
      <ColumnDefinition x:Name="DetailColumn" Width="380" MinWidth="280"/>
    </Grid.ColumnDefinitions>

    <!-- ===============================================================
         Toolbar
         =============================================================== -->
    <DockPanel x:Name="OrdersToolbar" Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
        <Button x:Name="NewOrderButton" Content="Nuevo pedido"
                Style="{StaticResource PrimaryButton}"
                Command="{StaticResource NewOrderCommand}"/>
        <Button x:Name="ReserveButton" Content="Reservar" Margin="8,0,0,0"
                Style="{StaticResource SecondaryButton}"
                Command="{StaticResource ReserveStockCommand}"/>
        <Button x:Name="ShipButton" Content="Enviar" Margin="8,0,0,0"
                Style="{StaticResource SecondaryButton}"
                Command="{StaticResource ShipOrderCommand}"/>
        <Button x:Name="CancelOrderButton" Content="Cancelar pedido" Margin="8,0,0,0"
                Style="{StaticResource DangerButton}"
                Click="CancelOrder_Click"
                IsEnabled="{Binding SelectedOrder.CanCancel, FallbackValue=False}"/>
        <Button x:Name="ExportButton" Margin="16,0,0,0" Style="{StaticResource IconButton}"
                ToolTip="Exportar a CSV" Click="Export_Click">
          <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextBrush}"
                Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"/>
        </Button>
      </StackPanel>

      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <ComboBox x:Name="StatusFilter" Width="140"
                  ItemsSource="{StaticResource StatusFilters}" SelectedIndex="0"
                  SelectionChanged="StatusFilter_SelectionChanged"/>
        <DatePicker x:Name="FromDate" Margin="8,0,0,0" Width="120"
                    SelectedDate="{Binding From}"/>
        <DatePicker x:Name="ToDate" Margin="4,0,0,0" Width="120"
                    SelectedDate="{Binding To}"/>
        <!-- Both attributes present: x:Name wins over Name. -->
        <CheckBox x:Name="OnlyOverdue" Name="OverdueFilterLegacy" Margin="8,0,0,0"
                  Content="Solo con retraso" VerticalAlignment="Center"
                  Checked="OnlyOverdue_Checked" Unchecked="OnlyOverdue_Unchecked"/>
      </StackPanel>
      <Rectangle/>
    </DockPanel>

    <!-- ===============================================================
         Summary cards
         =============================================================== -->
    <UniformGrid x:Name="SummaryCards" Grid.Row="1" Grid.ColumnSpan="3" Rows="1"
                 Margin="0,0,0,8">
      <Border Style="{StaticResource Card}" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Text="Pendientes" Style="{StaticResource FieldLabel}"/>
          <TextBlock Text="{Binding Summary.Pending}" FontSize="22" FontWeight="Bold"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Text="Reservados hoy" Style="{StaticResource FieldLabel}"/>
          <TextBlock Text="{Binding Summary.ReservedToday}" FontSize="22" FontWeight="Bold"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Text="Enviados hoy" Style="{StaticResource FieldLabel}"/>
          <TextBlock Text="{Binding Summary.ShippedToday}" FontSize="22" FontWeight="Bold"
                     Foreground="{StaticResource SuccessBrush}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Facturación del día" Style="{StaticResource FieldLabel}"/>
          <TextBlock Text="{Binding Summary.RevenueToday, Converter={StaticResource Money}}"
                     FontSize="22" FontWeight="Bold"/>
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- ===============================================================
         Orders grid
         =============================================================== -->
    <DataGrid x:Name="OrdersGrid" Grid.Row="2" Grid.Column="0"
              Style="{StaticResource DataGridBase}"
              ItemsSource="{Binding Source={StaticResource OrdersSource}}"
              SelectedItem="{Binding SelectedOrder}"
              SelectionChanged="OrdersGrid_SelectionChanged"
              MouseDoubleClick="OrdersGrid_MouseDoubleClick"
              KeyDown="OrdersGrid_KeyDown"
              Sorting="OrdersGrid_Sorting">
      <DataGrid.GroupStyle>
        <GroupStyle HeaderTemplate="{StaticResource OrderGroupHeader}"/>
      </DataGrid.GroupStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Número" Binding="{Binding Number}" Width="110"
                            FontFamily="{StaticResource MonoFont}"/>
        <DataGridTemplateColumn Header="Cliente" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ContentControl ContentTemplate="{StaticResource CustomerChip}"
                              Content="{Binding Customer}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Estado" Width="110"
                                CellTemplate="{StaticResource StatusPill}"/>
        <DataGridTextColumn Header="Líneas" Binding="{Binding Lines.Count}" Width="60"/>
        <DataGridTemplateColumn Header="Total" Width="110" SortMemberPath="Total.Amount">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ContentControl ContentTemplate="{StaticResource MoneyCell}"
                              Content="{Binding Total}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Creado"
                            Binding="{Binding CreatedAt, Converter={StaticResource RelativeTime}}"
                            Width="120"/>
        <DataGridCheckBoxColumn Header="Urgente" Binding="{Binding IsUrgent}" Width="70"/>
      </DataGrid.Columns>
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Abrir" Click="OpenOrder_Click" FontWeight="Bold"/>
          <MenuItem Header="Duplicar" Click="DuplicateOrder_Click"/>
          <MenuItem Header="Copiar número" Click="CopyOrderNumber_Click"/>
          <Separator/>
          <MenuItem Header="Imprimir albarán" Click="PrintPackingSlip_Click"/>
          <MenuItem Header="Reenviar factura por correo" Click="ResendInvoice_Click"/>
        </ContextMenu>
      </DataGrid.ContextMenu>
    </DataGrid>

    <GridSplitter Grid.Row="2" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                  Background="Transparent" ShowsPreview="True"/>

    <!-- ===============================================================
         Detail pane for the selected order
         =============================================================== -->
    <ScrollViewer x:Name="DetailPane" Grid.Row="2" Grid.Column="2"
                  VerticalScrollBarVisibility="Auto"
                  Visibility="{Binding SelectedOrder, Converter={StaticResource NullToCollapsed}}">
      <StackPanel DataContext="{Binding SelectedOrder}">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <ContentControl DockPanel.Dock="Right" ContentTemplate="{StaticResource StatusPill}"
                              Content="{Binding}"/>
              <TextBlock Text="{Binding Number}" Style="{StaticResource SectionHeader}"/>
            </DockPanel>
            <TextBlock Text="Cliente" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding Customer.Name}"/>
            <TextBlock Text="{Binding Customer.Email}" Foreground="{DynamicResource MutedTextBrush}"/>
            <TextBlock Text="Dirección de envío" Style="{StaticResource FieldLabel}" Margin="0,8,0,2"/>
            <TextBlock Text="{Binding ShippingAddress}" TextWrapping="Wrap"/>
            <Button Content="Editar dirección" HorizontalAlignment="Left" Margin="0,6,0,0"
                    Style="{StaticResource SecondaryButton}" Click="EditAddress_Click"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Líneas" Style="{StaticResource SectionHeader}"/>
            <ItemsControl x:Name="DetailLines" ItemsSource="{Binding Lines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="50"/>
                      <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Product.Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='× {0}'}"
                               TextAlignment="Right"/>
                    <ContentControl Grid.Column="2" ContentTemplate="{StaticResource MoneyCell}"
                                    Content="{Binding Subtotal}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Separator Margin="0,6"/>
            <DockPanel>
              <ContentControl DockPanel.Dock="Right" ContentTemplate="{StaticResource MoneyCell}"
                              Content="{Binding Total}" FontWeight="Bold"/>
              <TextBlock Text="Total" FontWeight="Bold"/>
            </DockPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Historial" Style="{StaticResource SectionHeader}"/>
            <ListBox x:Name="HistoryList" ItemsSource="{Binding History}" BorderThickness="0"
                     MaxHeight="220" MouseDoubleClick="HistoryList_MouseDoubleClick">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,2">
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                    <TextBlock FontSize="10" Foreground="{DynamicResource MutedTextBrush}">
                      <Run Text="{Binding Author}"/>
                      <Run Text=" · "/>
                      <Run Text="{Binding At, Converter={StaticResource RelativeTime}}"/>
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBox x:Name="NoteInput" Style="{StaticResource BaseTextBox}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                     Tag="Añadir una nota…"
                     TextChanged="NoteInput_TextChanged"/>
            <Button x:Name="AddNoteButton" Content="Añadir nota" HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}" Click="AddNote_Click"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Bulk actions, shown over the grid while several rows are selected -->
    <Border x:Name="BulkActions" Grid.Row="2" Grid.Column="0" VerticalAlignment="Bottom"
            HorizontalAlignment="Center" Margin="0,0,0,16" Padding="12,6"
            Background="{DynamicResource TextBrush}" CornerRadius="18"
            Visibility="{Binding HasMultipleSelection, Converter={StaticResource BoolToVisibility}}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"
                   Text="{Binding SelectedCount, StringFormat='{}{0} seleccionados'}"/>
        <Button Content="Reservar todos" Style="{StaticResource PrimaryButton}"
                Click="ReserveSelected_Click"/>
        <Button Content="Imprimir albaranes" Margin="8,0,0,0"
                Style="{StaticResource SecondaryButton}" Foreground="White"
                Click="PrintSelected_Click"/>
        <Button Content="Asignar transportista…" Margin="8,0,0,0"
                Style="{StaticResource SecondaryButton}" Foreground="White"
                Click="AssignCarrier_Click"/>
        <Button Style="{StaticResource IconButton}" Content="✕" Foreground="White"
                Margin="8,0,0,0" ToolTip="Quitar selección" Click="ClearSelection_Click"/>
      </StackPanel>
    </Border>

    <!-- Empty state when the filter leaves no orders -->
    <ContentControl Grid.Row="2" Grid.Column="0"
                    ContentTemplate="{StaticResource EmptyState}"
                    Content="No hay pedidos que coincidan con el filtro."
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
  </Grid>
</UserControl>
