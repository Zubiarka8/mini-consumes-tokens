<UserControl x:Class="Warehouse.Desktop.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Warehouse.Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{StaticResource DesignInventory}"
             x:Name="InventoryRoot"
             AllowDrop="True"
             Drop="InventoryRoot_Drop"
             DragEnter="InventoryRoot_DragEnter"
             DragLeave="InventoryRoot_DragLeave">
  <!--
    Inventory section: a zone map of the warehouse, the stock list and a
    put-away panel that accepts CSV files dropped from the desktop. Shown by
    MainWindow's ContentHost for an InventoryViewModel. Shares StockCell,
    MoneyCell and EmptyState with OrdersView through App.xaml.
  -->
  <UserControl.Resources>
    <DataTemplate x:Key="ZoneTile">
      <Border x:Name="ZoneBorder" Width="120" Height="72" Margin="4" CornerRadius="6"
              Background="{DynamicResource SurfaceAltBrush}" Cursor="Hand"
              MouseEnter="Zone_MouseEnter" MouseLeave="Zone_MouseLeave"
              MouseUp="Zone_MouseUp">
        <Grid Margin="8">
          <TextBlock Text="{Binding Code}" FontWeight="Bold" FontSize="16"/>
          <TextBlock Text="{Binding Kind, Converter={StaticResource EnumDisplay}}"
                     VerticalAlignment="Bottom" FontSize="10"
                     Foreground="{DynamicResource MutedTextBrush}"/>
          <ProgressBar x:Name="ZoneFill" Height="4" VerticalAlignment="Bottom"
                       Margin="0,0,0,-4" Maximum="1" Value="{Binding Occupancy}"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="ZoneBorder" Property="Background"
                  Value="{DynamicResource PrimaryBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Chilled">
          <Setter TargetName="ZoneFill" Property="Foreground" Value="#FF38BDF8"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Frozen">
          <Setter TargetName="ZoneFill" Property="Foreground" Value="#FF6366F1"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="ZoneMapPanel">
      <WrapPanel Orientation="Horizontal"/>
    </ItemsPanelTemplate>

    <DataTemplate x:Key="LotRow">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="80"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Id}" FontFamily="{StaticResource MonoFont}"/>
        <TextBlock Grid.Column="1" Text="{Binding Expires, StringFormat='caduca {0:d}'}"/>
        <TextBlock Grid.Column="2" Text="{Binding Quantity}" TextAlignment="Right"/>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel x:Name="InventoryLayout" LastChildFill="True">

    <!-- ===============================================================
         Zone map
         =============================================================== -->
    <Border x:Name="ZoneMapCard" DockPanel.Dock="Top" Style="{StaticResource Card}">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top">
          <ToggleButton x:Name="ShowEmptyZones" DockPanel.Dock="Right"
                        Content="Mostrar zonas vacías"
                        Checked="ShowEmptyZones_Checked" Unchecked="ShowEmptyZones_Unchecked"/>
          <TextBlock Text="Mapa del almacén" Style="{StaticResource SectionHeader}"/>
        </DockPanel>
        <StackPanel x:Name="ZoneLegend" DockPanel.Dock="Bottom" Orientation="Horizontal"
                    Margin="4,8,0,0">
          <Rectangle Width="10" Height="10" Fill="{DynamicResource SurfaceAltBrush}"/>
          <TextBlock Text="Ambiente" Margin="4,0,12,0" FontSize="11"/>
          <Rectangle Width="10" Height="10" Fill="#FF38BDF8"/>
          <TextBlock Text="Refrigerado" Margin="4,0,12,0" FontSize="11"/>
          <Rectangle Width="10" Height="10" Fill="#FF6366F1"/>
          <TextBlock Text="Congelado" Margin="4,0,12,0" FontSize="11"/>
          <Rectangle Width="10" Height="10" Fill="{DynamicResource PrimaryBrush}"/>
          <TextBlock Text="Seleccionada" Margin="4,0,12,0" FontSize="11"/>
          <TextBlock Text="{Binding Zones.Count, StringFormat='{}{0} zonas'}" FontSize="11"
                     Foreground="{DynamicResource MutedTextBrush}"/>
        </StackPanel>
        <ItemsControl x:Name="ZoneMap" ItemsSource="{Binding Zones}"
                      ItemTemplate="{StaticResource ZoneTile}"
                      ItemsPanel="{StaticResource ZoneMapPanel}"
                      KeyDown="ZoneMap_KeyDown"/>
      </DockPanel>
    </Border>

    <!-- ===============================================================
         Put-away panel (right). Accepts dropped receipt files.
         =============================================================== -->
    <Border x:Name="PutAwayPanel" DockPanel.Dock="Right" Width="320" Margin="12,0,0,0"
            Style="{StaticResource Card}" AllowDrop="True"
            DragOver="PutAwayPanel_DragOver" Drop="PutAwayPanel_Drop">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Ubicar mercancía"
                   Style="{StaticResource SectionHeader}"/>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="Albarán de entrada" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="ReceiptNumber" Style="{StaticResource BaseTextBox}"
                   Text="{Binding PutAway.ReceiptNumber, UpdateSourceTrigger=PropertyChanged}"
                   KeyUp="ReceiptNumber_KeyUp"/>
          <TextBlock Text="Producto" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="PutAwayProduct" IsEditable="True" IsTextSearchEnabled="True"
                    ItemsSource="{Binding Products}" DisplayMemberPath="Name"
                    SelectedItem="{Binding PutAway.Product}"
                    SelectionChanged="PutAwayProduct_SelectionChanged"/>
          <TextBlock Text="Cantidad" Style="{StaticResource FieldLabel}" Margin="0,8,0,2"/>
          <controls:QuantityStepper x:Name="PutAwayQuantity" Minimum="1" Maximum="9999"
                                    Value="{Binding PutAway.Quantity}"
                                    ValueChanged="PutAwayQuantity_ValueChanged"/>
          <TextBlock Text="Ubicación sugerida" Style="{StaticResource FieldLabel}" Margin="0,8,0,2"/>
          <TextBlock x:Name="SuggestedLocation" Text="{Binding PutAway.SuggestedLocation}"
                     FontFamily="{StaticResource MonoFont}" FontSize="16"/>
          <Slider x:Name="ConfidenceSlider" Minimum="0" Maximum="1"
                  Value="{Binding PutAway.MinConfidence}" TickFrequency="0.1"
                  IsSnapToTickEnabled="True"
                  ValueChanged="ConfidenceSlider_ValueChanged"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="{StaticResource CancelLabel}" Style="{StaticResource SecondaryButton}"
                  Click="PutAwayCancel_Click"/>
          <Button x:Name="ConfirmPutAway" Content="Confirmar" Margin="8,0,0,0"
                  Style="{StaticResource PrimaryButton}" Click="ConfirmPutAway_Click"
                  IsDefault="True"/>
        </StackPanel>
        <Border x:Name="DropHint" BorderThickness="2" CornerRadius="6" Margin="0,12"
                BorderBrush="{DynamicResource SurfaceAltBrush}"
                Visibility="{Binding IsDragging, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="Suelta aquí un CSV de entrada" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
        </Border>
      </DockPanel>
    </Border>

    <!-- ===============================================================
         Cycle count and movements (bottom). Two tabs over the same
         selected product.
         =============================================================== -->
    <TabControl x:Name="InventoryTabs" DockPanel.Dock="Bottom" Height="230" Margin="0,12,0,0"
                SelectionChanged="InventoryTabs_SelectionChanged">
      <TabItem x:Name="CycleCountTab" Header="Recuento cíclico">
        <Grid x:Name="CycleCountForm" Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Ubicación a contar" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="CountLocation" ItemsSource="{Binding CountLocations}"
                      SelectedItem="{Binding Count.Location}"
                      SelectionChanged="CountLocation_SelectionChanged"/>
            <TextBlock Text="Existencias según sistema" Style="{StaticResource FieldLabel}"
                       Margin="0,8,0,2"/>
            <TextBlock x:Name="SystemQuantity" Text="{Binding Count.Expected}" FontSize="18"
                       FontFamily="{StaticResource MonoFont}"/>
            <TextBlock Text="Contado" Style="{StaticResource FieldLabel}" Margin="0,8,0,2"/>
            <controls:QuantityStepper x:Name="CountedQuantity" Minimum="0" Maximum="99999"
                                      Value="{Binding Count.Counted}"
                                      ValueChanged="CountedQuantity_ValueChanged"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Diferencia" Style="{StaticResource FieldLabel}"/>
            <TextBlock x:Name="CountDifference" FontSize="18" FontWeight="Bold"
                       Text="{Binding Count.Difference, StringFormat='{}{0:+0;-0;0}'}"
                       Foreground="{Binding Count.Difference, Converter={StaticResource StockBrush}}"/>
            <TextBlock Text="Motivo del ajuste" Style="{StaticResource FieldLabel}" Margin="0,8,0,2"/>
            <ComboBox x:Name="AdjustmentReason" ItemsSource="{Binding AdjustmentReasons}"
                      SelectedItem="{Binding Count.Reason}"
                      IsEnabled="{Binding Count.HasDifference}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
              <Button Content="Recontar" Style="{StaticResource SecondaryButton}"
                      Click="Recount_Click"/>
              <Button x:Name="PostCount" Content="Registrar recuento" Margin="8,0,0,0"
                      Style="{StaticResource PrimaryButton}" Click="PostCount_Click"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem x:Name="MovementsTab" Header="Movimientos">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <DatePicker x:Name="MovementsFrom" Width="120" SelectedDate="{Binding MovementsFrom}"
                        SelectedDateChanged="MovementsRange_Changed"/>
            <DatePicker x:Name="MovementsTo" Width="120" Margin="4,0,0,0"
                        SelectedDate="{Binding MovementsTo}"
                        SelectedDateChanged="MovementsRange_Changed"/>
            <ComboBox x:Name="MovementKind" Width="140" Margin="8,0,0,0"
                      ItemsSource="{Binding MovementKinds}" SelectedIndex="0"
                      SelectionChanged="MovementKind_SelectionChanged"/>
          </StackPanel>
          <ListView x:Name="MovementsList" ItemsSource="{Binding Movements}"
                    MouseDoubleClick="MovementsList_MouseDoubleClick">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Fecha" Width="140"
                                DisplayMemberBinding="{Binding At, StringFormat='g'}"/>
                <GridViewColumn Header="Tipo" Width="110"
                                DisplayMemberBinding="{Binding Kind, Converter={StaticResource EnumDisplay}}"/>
                <GridViewColumn Header="Cantidad" Width="80"
                                DisplayMemberBinding="{Binding Quantity}"/>
                <GridViewColumn Header="Origen" Width="100"
                                DisplayMemberBinding="{Binding From}"/>
                <GridViewColumn Header="Destino" Width="100"
                                DisplayMemberBinding="{Binding To}"/>
                <GridViewColumn Header="Documento" Width="140"
                                DisplayMemberBinding="{Binding Document}"/>
                <GridViewColumn Header="Lote" Width="120"
                                DisplayMemberBinding="{Binding LotId}"/>
                <GridViewColumn Header="Usuario" Width="120"
                                DisplayMemberBinding="{Binding User}"/>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>
    </TabControl>

    <!-- ===============================================================
         Stock list with lots (row details)
         =============================================================== -->
    <Grid x:Name="StockArea">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="0,0,0,8">
        <TextBox x:Name="StockSearch" Width="260" DockPanel.Dock="Left"
                 Style="{StaticResource SearchBox}" Tag="Buscar SKU o nombre…"
                 TextChanged="StockSearch_TextChanged"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <RadioButton x:Name="AllStock" GroupName="StockFilter" Content="Todo" IsChecked="True"
                       Checked="StockFilter_Checked"/>
          <RadioButton x:Name="LowStock" GroupName="StockFilter" Content="Bajo mínimo"
                       Margin="8,0,0,0" Checked="StockFilter_Checked"/>
          <RadioButton x:Name="ExpiringStock" GroupName="StockFilter" Content="Caduca pronto"
                       Margin="8,0,0,0" Checked="StockFilter_Checked"/>
          <Button x:Name="ReorderButton" Content="Generar pedido de compra" Margin="16,0,0,0"
                  Style="{StaticResource PrimaryButton}" Click="Reorder_Click"
                  IsEnabled="{Binding HasLowStock}"/>
        </StackPanel>
      </DockPanel>

      <DataGrid x:Name="StockGrid" Grid.Row="1" Style="{StaticResource DataGridBase}"
                ItemsSource="{Binding Stock}"
                RowDetailsVisibilityMode="VisibleWhenSelected"
                SelectionChanged="StockGrid_SelectionChanged"
                PreviewMouseMove="StockGrid_PreviewMouseMove"
                CellEditEnding="StockGrid_CellEditEnding">
        <DataGrid.Columns>
          <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110" IsReadOnly="True"
                              FontFamily="{StaticResource MonoFont}"/>
          <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
          <DataGridTextColumn Header="Ubicación" Binding="{Binding Location}" Width="100"/>
          <DataGridTemplateColumn Header="Disponible" Width="110"
                                  CellTemplate="{StaticResource StockCell}"/>
          <DataGridTextColumn Header="Punto de pedido" Binding="{Binding ReorderPoint}" Width="120"/>
          <DataGridTemplateColumn Header="Precio" Width="100"
                                  CellTemplate="{StaticResource MoneyCell}"/>
        </DataGrid.Columns>
        <DataGrid.RowDetailsTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource SurfaceAltBrush}" Padding="24,6">
              <StackPanel>
                <TextBlock Text="Lotes" Style="{StaticResource FieldLabel}"/>
                <ItemsControl ItemsSource="{Binding Lots}" ItemTemplate="{StaticResource LotRow}"/>
                <Button Content="Ajustar existencias…" HorizontalAlignment="Left" Margin="0,6,0,0"
                        Style="{StaticResource SecondaryButton}" Click="AdjustStock_Click"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </DataGrid.RowDetailsTemplate>
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Mover a otra ubicación…" Click="MoveStock_Click"/>
            <MenuItem Header="Imprimir etiqueta" Click="PrintShelfLabel_Click"/>
            <MenuItem Header="Ver movimientos" Click="ShowMovements_Click"/>
          </ContextMenu>
        </DataGrid.ContextMenu>
      </DataGrid>

      <ContentControl Grid.Row="1" ContentTemplate="{StaticResource EmptyState}"
                      Content="No hay existencias para este filtro."
                      Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
    </Grid>
  </DockPanel>
</UserControl>
